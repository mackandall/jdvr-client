# Settings for nextpvr-comskip.py; copy to nextpvr-comskip.conf. Every line is optional.
[scanner]
# Where NextPVR records, comma separated; empty: read from NextPVR's config.xml.
#recording_dirs =
# Look for new recordings every N seconds.
#interval = 60
# Only scan a recording once its file hasn't changed for N seconds.
#settle = 120
# Commercial-free channels, never scanned: names as NextPVR shows them, or channel OIDs.
#skip_channels =
# If set, only these channels are scanned.
#only_channels =
# Genres never scanned, e.g. News, Sports.
#skip_genres =
# Shows never scanned (titles as NextPVR shows them): one show on a channel that's otherwise scanned.
#skip_shows =
# Also scan recordings made before the scanner first ran.
#backfill = true
# Attempts before a recording is given up on.
#max_attempts = 3
# CPU priority for Comskip (19 = lowest).
#nice = 15
# Port for the page (http://<this machine>:8867/) and JDVR's badges; 0 turns it off.
#port = 8867
# NextPVR, for checking the PIN when the page unlocks.
#nextpvr_url = http://127.0.0.1:8866

# Transcoding (also on the page). Converts recordings once they have their marks and switches
# NextPVR to the new file; the PIN is saved from the page.
#transcode = false
# hevc, h264 or av1.
#transcode_codec = hevc
# auto, or an encoder by name: hevc_vaapi, libx265, h264_vaapi, libx264, av1_vaapi, libsvtav1.
#transcode_encoder = auto
# smaller, balanced or better.
#transcode_quality = balanced
# Shrink taller pictures to this height; 0 keeps the size.
#transcode_max_height = 0
# mkv or mp4.
#transcode_container = mkv
# copy (as recorded) or aac.
#transcode_audio = copy
# Days the original is kept in .originals; 0 deletes it straight away.
#transcode_keep_days = 2
# Only between these hours, e.g. 1-6; empty: any time.
#transcode_hours =
# Hours after a recording ends before it's transcoded.
#transcode_wait_hours = 0
# Also recordings made before transcoding was switched on.
#transcode_backfill = false
#transcode_skip_channels =
#transcode_skip_shows =
#vaapi_device = /dev/dri/renderD128
